{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/media/**",
              "components/navigation/**",
              "ui_kits/piche/**",
              "ui_kits/showroom-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Figtree))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Figtree."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|width|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, width, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|secondary-translucent)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'secondary-translucent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Carousel'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|index|onChange|children|style|key|ref|className|style|children)$/]",
        "message": "<Carousel> doesn't accept that prop. Declared props: count, index, onChange, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|image|height|style|key|ref|className|style|children)$/]",
        "message": "<CategoryCard> doesn't accept that prop. Declared props: label, image, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|ctaLabel|onSend|style|key|ref|className|style|children)$/]",
        "message": "<ChatBar> doesn't accept that prop. Declared props: label, placeholder, ctaLabel, onSend, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|promo|image|children|height|align|style|key|ref|className|style|children)$/]",
        "message": "<HeroSection> doesn't accept that prop. Declared props: title, promo, image, children, height, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroSection'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:top|split)$/]",
        "message": "<HeroSection> align must be one of 'top' | 'split'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:bordered|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: bordered."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|tone|children|key|ref|className|style|children)$/]",
        "message": "<NavButton> doesn't accept that prop. Declared props: active, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<NavButton> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|children|links|style|key|ref|className|style|children)$/]",
        "message": "<NavPanel> doesn't accept that prop. Declared props: open, children, links, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Photo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|label|ratio|tone|style|key|ref|className|style|children)$/]",
        "message": "<Photo> doesn't accept that prop. Declared props: src, alt, label, ratio, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Photo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Photo> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:wordmark|items|active|onSelect|tone|frosted|children|style|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: wordmark, items, active, onSelect, tone, frosted, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<SiteHeader> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|weight|children|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: href, weight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='VehicleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|image|links|style|key|ref|className|style|children)$/]",
        "message": "<VehicleCard> doesn't accept that prop. Declared props: name, image, links, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
